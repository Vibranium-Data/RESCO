{
  "@context": {
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "resco": "http://github.com/vibranium-data/resco"
  },
  "@graph": [
    {
      "@id": "resco:Entity",
      "@type": "rdfs:Class",
      "rdfs:label": "Entity",
      "rdfs:comment": "A generic entity that can represent a System, Asset, Sensor, Organization or even Individual."
    },
    {
      "@id": "resco:Measurement",
      "@type": "rdfs:Class",
      "rdfs:label": "Measurement",
      "rdfs:comment": "A recorded observation with a value and timestamp, typically generated by a Sensor."
    },
    {
      "@id": "resco:Indicator",
      "@type": "rdfs:Class",
      "rdfs:label": "Indicator",
      "rdfs:comment": "An aggregated or derived measure based on one or more Measurements, often aligned with policy or research goals."
    },
    {
      "@id": "resco:Condition",
      "@type": "rdfs:Class",
      "rdfs:label": "Condition",
      "rdfs:comment": "A qualitative or categorical state of an Entity, inferred from Indicators or Measurements."
    },
    {
      "@id": "resco:Event",
      "@type": "rdfs:Class",
      "rdfs:label": "Event",
      "rdfs:comment": "A discrete occurrence affecting or involving one or more Entities (e.g., a sensor reading, a bus breakdown, a traffic light change), or their Conditions (e.g. a maintenance Event changing a power plant's condition from Operational to Under Maintenance)."
    },
    {
      "@id": "resco:Intervention",
      "@type": "rdfs:Class",
      "rdfs:label": "Intervention",
      "rdfs:comment": "An action taken to change the state of an Entity or System, aimed at improving conditions or achieving policy goals."
    },

    {"_comment": "RESCO class property definitions follow"},

    {"_comment": "RESCO Entity class properties"},

    {
      "@id": "resco:entityId",
      "@type": "rdf:Property",
      "rdfs:label": "entityId",
      "rdfs:domain": "resco:Entity",
      "rdfs:range": "xsd:string",
      "rdfs:comment": "Unique identifier for the entity"
    },

    {
      "@id": "resco:entityName",
      "@type": "rdf:Property",
      "rdfs:domain": "resco:Entity",
      "rdfs:range": "xsd:string",
      "rdfs:comment": "A human-readable label or name for the entity."
    },
    {
      "@id": "resco:entityType",
      "@type": "rdf:Property",
      "rdfs:domain": "resco:Entity",
      "rdfs:range": "xsd:string",
      "rdfs:comment": "Category of entity (e.g., system, asset, sensor, organization)."
    },
    {
      "@id": "resco:hasCondition",
      "@type": "rdf:Property",
      "rdfs:domain": "resco:Entity",
      "rdfs:range": "resco:Condition",
      "rdfs:comment": "Associates an entity with one or more conditions related to it"
    },
    {
      "@id": "resco:entityTag",
      "@type": "rdf:Property",
      "rdfs:domain": "resco:Entity",
      "rdfs:range": "xsd:string",
      "rdfs:comment": "Arbitrary labels for filtering or grouping entities."
    },
    {
      "@id": "resco:hasMeasurement",
      "@type": "rdf:Property",
      "rdfs:domain": [
                    "resco:Entity",
                    "resco:Event"
                     ],
      "rdfs:range": "resco:Measurement",
      "rdfs:comment": "Associates an entity with measurements it generates or is described by."
    },


    {"_comment": "RESCO Measurement class properties"},

    {
      "@id": "resco:measurementId",
      "@type": "rdf:Property",
      "rdfs:label": "measurementId",
      "rdfs:domain": "resco:Measurement",
      "rdfs:range": "xsd:string",
      "rdfs:comment": "Unique identifier for the measurement"
    },
     {
      "@id": "resco:measurementLabel",
      "@type": "rdf:Property",
      "rdfs:domain": "resco:Measurement",
      "rdfs:range": "xsd:string",
      "rdfs:comment": "The name of the qualitative or quantitative measurement."
    },
    {
      "@id": "resco:measurementValue",
      "@type": "rdf:Property",
      "rdfs:domain": "resco:Measurement",
      "rdfs:range": "xsd:float",
      "rdfs:comment": "The numeric value of the measurement."
    },
    {
      "@id": "resco:measurementUnit",
      "@type": "rdf:Property",
      "rdfs:domain": "resco:Measurement",
      "rdfs:range": "xsd:string",
      "rdfs:comment": "Unit of the measurement (e.g., °C, ppm, km, mph, L/min, pm2.5, sqft, $, v)."
    },
    {
      "@id": "resco:measurementTime",
      "@type": "rdf:Property",
      "rdfs:domain": "resco:Measurement",
      "rdfs:range": "xsd:dateTime",
      "rdfs:comment": "Timestamp of the measurement."
    },
    {
      "@id": "resco:generatedBy",
      "@type": "rdf:Property",
      "rdfs:domain": "resco:Measurement",
      "rdfs:range": "resco:Entity",
      "rdfs:comment": "Links a measurement to the Entity that generated it."
    },

    {"_comment": "RESCO Indicator class properties"},

    {
      "@id": "resco:indicatorId",
      "@type": "rdf:Property",
      "rdfs:label": "indicatorId",
      "rdfs:domain": "resco:Indicator",
      "rdfs:range": "xsd:string",
      "rdfs:comment": "Unique identifier for the indicator"
    },

    {
      "@id": "resco:basedOnMeasurement",
      "@type": "rdf:Property",
      "rdfs:domain": "resco:Indicator",
      "rdfs:range": "resco:Measurement",
      "rdfs:comment": "Associates an indicator with one or more measurements it is derived from."
    },
    {
      "@id": "resco:indicatorValue",
      "@type": "rdf:Property",
      "rdfs:domain": "resco:Indicator",
      "rdfs:range": "xsd:float",
      "rdfs:comment": "The aggregated or derived numeric value of the indicator."
    },
    {
      "@id": "resco:indicatorUnit",
      "@type": "rdf:Property",
      "rdfs:domain": "resco:Indicator",
      "rdfs:range": "xsd:string",
      "rdfs:comment": "The unit of the indicator (if applicable)."
    },
    {
      "@id": "resco:indicatesCondition",
      "@type": "rdf:Property",
      "rdfs:domain": "resco:Indicator",
      "rdfs:range": "resco:Condition",
      "rdfs:comment": "The condition inferred from the indicator."
    },

    {"_comment": "RESCO Condition class properties"},

    {
      "@id": "resco:conditionId",
      "@type": "rdf:Property",
      "rdfs:label": "conditionId",
      "rdfs:domain": "resco:Condition",
      "rdfs:range": "xsd:string",
      "rdfs:comment": "Unique identifier for the condition"
    },

    {
      "@id": "resco:conditionLabel",
      "@type": "rdf:Property",
      "rdfs:domain": "resco:Condition",
      "rdfs:range": "xsd:string",
      "rdfs:comment": "An identifier with the name of the condition being described."
    },
    {
      "@id": "resco:conditionOptions",
      "@type": "rdf:Property",
      "rdfs:domain": "resco:Condition",
      "rdfs:range": "xsd:string",
      "rdfs:comment": "Human readable descriptors for the condition (e.g., 'Good', 'Poor', 'Functional', 'Under Maintenance')."
    },
    {
      "@id": "resco:conditionValue",
      "@type": "rdf:Property",
      "rdfs:domain": "resco:Condition",
      "rdfs:range": "xsd:string",
      "rdfs:comment": "The value of the condition which is one of the conditionOptions."
    },
    {
      "@id": "resco:derivedFrom",
      "@type": "rdf:Property",
      "rdfs:domain": "resco:Condition",
      "rdfs:range": "xsd:string",
      "rdfs:comment": "Optional: The Indicator(s) or Measurement(s) the Condition is derived from. Optional mirror for indicatesCondition."
    },
    
    {
      "@id": "resco:appliesTo",
      "@type": "rdf:Property",
      "rdfs:domain": "resco:Condition",
      "rdfs:range": [
                    "resco:Entity",
                    "resco:Event"
                    ],
      "rdfs:comment": "The entity or event this condition applies to."
    },
    {
      "@id": "resco:conditionTag",
      "@type": "rdf:Property",
      "rdfs:domain": "resco:Condition",
      "rdfs:range": "xsd:string",
      "rdfs:comment": "Optional labels/tags for filtering conditions."
    },

    {"_comment": "RESCO Event class properties"},
    {
      "@id": "resco:eventId",
      "@type": "rdf:Property",
      "rdfs:label": "eventId",
      "rdfs:domain": "resco:Event",
      "rdfs:range": "xsd:string",
      "rdfs:comment": "Unique identifier for the event"
    },

    {
      "@id": "resco:involvedEntity",
      "@type": "rdf:Property",
      "rdfs:domain": "resco:Event",
      "rdfs:range": "resco:Entity",
      "rdfs:comment": "Associates an event with the entities involved."
    },
    {
      "@id": "resco:eventTime",
      "@type": "rdf:Property",
      "rdfs:domain": "resco:Event",
      "rdfs:range": "xsd:dateTime",
      "rdfs:comment": "Timestamp of the event."
    },
    {
      "@id": "resco:generatedByEvent",
      "@type": "rdf:Property",
      "rdfs:domain": "resco:Event",
      "rdfs:range": "resco:Entity",
      "rdfs:comment": "Specifies the entity that generated/caused the event."
    },

    {"_comment": "RESCO Intervention class properties"},

    {
      "@id": "resco:interventionId",
      "@type": "rdf:Property",
      "rdfs:label": "interventionId",
      "rdfs:domain": "resco:Intervention",
      "rdfs:range": "xsd:string",
      "rdfs:comment": "Unique identifier for the intervention"
    },

    {
      "@id": "resco:interventionLabel",
      "@type": "rdf:Property",
      "rdfs:domain": "resco:Intervention",
      "rdfs:range": "xsd:string",
      "rdfs:comment": "Name of the intervention."
    },
    {
      "@id": "resco:interventionDescription",
      "@type": "rdf:Property",
      "rdfs:domain": "resco:Intervention",
      "rdfs:range": "xsd:string",
      "rdfs:comment": "Description of the intervention."
    },
    {
      "@id": "resco:implementedBy",
      "@type": "rdf:Property",
      "rdfs:domain": "resco:Intervention",
      "rdfs:range": "resco:Entity",
      "rdfs:comment": "The organization or entity responsible for the intervention."
    },
    {
      "@id": "resco:appliesToEntity",
      "@type": "rdf:Property",
      "rdfs:domain": "resco:Intervention",
      "rdfs:range": "resco:Entity",
      "rdfs:comment": "The entity the intervention is targeting."
    },
    {
      "@id": "resco:currentEntityCondition",
      "@type": "rdf:Property",
      "rdfs:domain": "resco:Intervention",
      "rdfs:range": "resco:Condition",
      "rdfs:comment": "The current condition of the target entity."
    },
    {
      "@id": "resco:targetEntityCondition",
      "@type": "rdf:Property",
      "rdfs:domain": "resco:Intervention",
      "rdfs:range": "resco:Condition",
      "rdfs:comment": "The desired condition of the target entity after intervention."
    },
    {
      "@id": "resco:basedOnIndicator",
      "@type": "rdf:Property",
      "rdfs:domain": "resco:Intervention",
      "rdfs:range": "resco:Indicator",
      "rdfs:comment": "One or more indicators informing the intervention design."
    },
    {
      "@id": "resco:targetIndicatorLevel",
      "@type": "rdf:Property",
      "rdfs:domain": "resco:Intervention",
      "rdfs:range": "xsd:float",
      "rdfs:comment": "Optional numeric goal for the intervention."
    },
    {
      "@id": "resco:interventionStatus",
      "@type": "rdf:Property",
      "rdfs:domain": "resco:Intervention",
      "rdfs:range": "xsd:string",
      "rdfs:comment": "The current phase/state of the intervention (e.g., planned, in progress, completed)."
    },
    {
      "@id": "resco:interventionOutcome",
      "@type": "rdf:Property",
      "rdfs:domain": "resco:Intervention",
      "rdfs:range": "xsd:string",
      "rdfs:comment": "The result of the intervention (e.g., successful, unsuccessful)."
    },
    {
      "@id": "resco:interventionStartTime",
      "@type": "rdf:Property",
      "rdfs:domain": "resco:Intervention",
      "rdfs:range": "xsd:dateTime",
      "rdfs:comment": "Start time of the intervention."
    },
    {
      "@id": "resco:interventionEndTime",
      "@type": "rdf:Property",
      "rdfs:domain": "resco:Intervention",
      "rdfs:range": "xsd:dateTime",
      "rdfs:comment": "End time of the intervention."
    },
    {
      "@id": "resco:interventionTag",
      "@type": "rdf:Property",
      "rdfs:domain": "resco:Intervention",
      "rdfs:range": "xsd:string",
      "rdfs:comment": "Tags or labels for filtering/grouping interventions."
    }
  ]
}
